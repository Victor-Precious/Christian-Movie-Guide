rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Each signed-in user can READ their own subscription status,
    // but can never write to it directly — only the Cloud Functions
    // (using the Admin SDK, which bypasses these rules) can set it.
    // This stops someone from just editing their own record in the
    // browser to fake a subscription.
    match /customers/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

  }
}
